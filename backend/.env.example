# Copie este arquivo para ".env" (o .env NÃO vai para o Git).
# Troque [SENHA] pela senha do banco do projeto Supabase (peça ao grupo; nunca commite).
PORT=3001

# Aplicação (Transaction pooler, porta 6543). pgbouncer=true avisa o Prisma que há pooler.
DATABASE_URL="postgresql://postgres.qttsdrayzymwrspsnifx:[SENHA]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrações (Session pooler, porta 5432). O prisma migrate não funciona bem pelo pooler da 6543.
DIRECT_URL="postgresql://postgres.qttsdrayzymwrspsnifx:[SENHA]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Segredo que assina os tokens de login (JWT). Mínimo 32 caracteres, NUNCA commitar o valor real.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
