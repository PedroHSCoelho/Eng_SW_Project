# Banco de DESENVOLVIMENTO (é o que o "npm run dev" usa). Copie para ".env" (o .env NÃO vai para o Git).
# Aponte para o projeto Supabase de DEV (ex.: "eng-sw-dev"), NUNCA para o de produção.
# A senha do banco de produção fica só no .env.production (ver docs/ambientes.md).
BANCO=dev
PORT=3001

# Aplicação (Transaction pooler, porta 6543). pgbouncer=true avisa o Prisma que há pooler.
DATABASE_URL="postgresql://postgres.[ID-DO-PROJETO-DEV]:[SENHA-DEV]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrações (Session pooler, porta 5432). O prisma migrate não funciona bem pelo pooler da 6543.
DIRECT_URL="postgresql://postgres.[ID-DO-PROJETO-DEV]:[SENHA-DEV]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# Segredo que assina os tokens de login (JWT). Mínimo 32 caracteres, NUNCA commitar o valor real.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
