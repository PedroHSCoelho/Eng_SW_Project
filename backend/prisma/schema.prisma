// Modelo de dados do projeto (PostgreSQL).
// Ponto de partida: o grupo vai adicionando os modelos conforme as features
// (Partida, Evento, Campeonato, Palpite...). Depois de editar, rode:
//   npx prisma migrate dev --name descricao-da-mudanca

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooler do Supabase (porta 6543): usada pela aplicação
  directUrl = env("DIRECT_URL") // conexão sem pgbouncer (porta 5432): usada só pelo prisma migrate
}

// Posição em campo. Nomes em inglês no código; a tela traduz.
enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

// Jogador cadastrado. Estatísticas (gols, assistências, partidas) NÃO ficam aqui:
// são calculadas a partir das súmulas, para não duplicar dado derivado.
model Player {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  nickname    String   @db.VarChar(30) // como o jogador quer ser exibido ("Zé")
  nicknameKey String   @unique @db.VarChar(30) // apelido em minúsculas: garante unicidade sem diferenciar maiúsculas
  position    Position
  active      Boolean  @default(true) // inativar em vez de excluir quem já tem partida
  createdAt   DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}
