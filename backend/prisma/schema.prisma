// Modelo de dados do projeto (PostgreSQL).
// Ponto de partida: o grupo vai adicionando os modelos conforme as features
// (Partida, Evento, Campeonato, Palpite...). Depois de editar, rode:
//   npx prisma migrate dev --name descricao-da-mudanca

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // "rhel" = Linux da Vercel; "native" = sua máquina
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler do Supabase (porta 6543): usada pela aplicação
  directUrl = env("DIRECT_URL") // conexão sem pgbouncer (porta 5432): usada só pelo prisma migrate
}

// Posição em campo. Nomes em inglês no código; a tela traduz.
enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

// Grupo (a "pelada" ou campeonato), como um grupo de WhatsApp: qualquer pessoa cria e vira
// organizadora; os outros entram pelo código de convite. Jogadores e partidas pertencem a um grupo.
model Group {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(60)
  inviteCode  String       @unique @db.VarChar(12) // código do link de convite; gerar outro invalida o antigo
  createdAt   DateTime     @default(now())
  memberships Membership[] // quem participa e com qual papel
  players     Player[]
  matches     Match[]
}

// Papel da pessoa DENTRO de um grupo (a mesma pessoa pode ser organizadora em um e membro em outro).
enum GroupRole {
  ORGANIZER
  MEMBER
}

// Participação de uma conta em um grupo. `playerId` é o jogador dessa pessoa NESTE grupo
// (opcional: um organizador pode não jogar). Um jogador tem no máximo uma conta.
model Membership {
  groupId  Int
  userId   Int
  role     GroupRole @default(MEMBER)
  playerId Int?      @unique
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  player   Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@id([groupId, userId])
  @@index([userId])
}

// Jogador cadastrado. Estatísticas (gols, assistências, partidas) NÃO ficam aqui:
// são calculadas a partir das súmulas, para não duplicar dado derivado.
model Player {
  id              Int           @id @default(autoincrement())
  groupId         Int // grupo dono do jogador (o "Zé" da quinta não é o mesmo da firma)
  name            String        @db.VarChar(50)
  nickname        String        @db.VarChar(30) // como o jogador quer ser exibido ("Zé")
  nicknameKey     String        @db.VarChar(30) // apelido em minúsculas: único DENTRO do grupo, sem diferenciar maiúsculas
  position        Position
  active          Boolean       @default(true) // inativar em vez de excluir quem já tem partida
  skill           Float? // nota do admin (0 a 5, de 0,5 em 0,5) para o sorteio; só admins veem
  createdAt       DateTime      @default(now())
  group           Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  membership      Membership? // conta ligada a este jogador no grupo (no máximo uma)
  matches         MatchPlayer[] // partidas em que foi escalado
  goals           Goal[]        @relation("GoalScorer") // gols que marcou (inclusive contra)
  assists         Goal[]        @relation("GoalAssist") // gols em que deu a assistência
  ratingsGiven    Rating[]      @relation("RatingGiven") // notas que deu
  ratingsReceived Rating[]      @relation("RatingReceived") // notas que recebeu
  events          MatchEvent[] // cartões e defesas difíceis lançados na súmula
  attendances     Attendance[] // presenças confirmadas nas partidas
  guestsInvited   MatchGuest[] // convidados que levou para as partidas
  votesGiven      MvpVote[]     @relation("VoteGiven") // votos de craque que deu
  votesReceived   MvpVote[]     @relation("VoteReceived") // votos de craque que recebeu
  photo           PlayerPhoto? // foto do jogador (tabela própria, para as consultas de Player não carregarem a imagem)

  @@unique([groupId, nicknameKey])
}

// Conta de login. Senha NUNCA em texto: só o hash do bcrypt.
// O papel (organizador/membro) e o jogador da pessoa ficam na participação de cada grupo (Membership).
model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique // sempre em minúsculas (normalizado pelo serviço)
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[] // grupos de que participa
}

// Estados da partida: agendada -> em andamento -> finalizada (só nessa ordem).
// Cancelada (CANCELED) é um estado final alcançável de agendada ou em andamento; não conta em
// histórico, estatísticas nem ranking.
enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELED
}

// Lado do campo. Não há times fixos: cada partida monta os seus times.
// Jogo único usa só A e B; a pelada usa de 3 a 6 (A a F).
enum Team {
  A
  B
  C
  D
  E
  F
}

// Formato da partida: um jogo só entre dois times, ou a pelada (vários times e vários jogos
// na mesma noite, escolhendo os dois times de cada jogo: "quem ganha fica").
enum MatchFormat {
  SINGLE_GAME
  PELADA
}

// Resultado de um jogo da pelada (mandante = homeTeam, visitante = awayTeam).
enum GameResult {
  HOME_WINS
  AWAY_WINS
  DRAW
}

// Resultado gravado ao encerrar a partida.
enum MatchResult {
  A_WINS
  B_WINS
  DRAW
}

// Partida (a "pelada"). O placar NÃO é guardado: é sempre calculado a partir dos gols.
// O resultado é gravado ao encerrar (depois disso a súmula não muda mais).
model Match {
  id          Int           @id @default(autoincrement())
  groupId     Int // grupo dono da partida (escalação, gols e notas vêm junto pela partida)
  date        DateTime // dia e hora da partida
  location    String        @db.VarChar(100)
  status      MatchStatus   @default(SCHEDULED)
  result      MatchResult? // vazio até a partida ser encerrada
  finishedAt  DateTime? // quando foi encerrada
  maxPlayers  Int? // vagas da lista de presença (vazio = sem limite); quem passa disso vai para a espera
  format      MatchFormat   @default(SINGLE_GAME)
  teamCount   Int           @default(2) // quantos times: 2 no jogo único, de 3 a 6 na pelada
  teamNames   Json? // nomes livres dos times, ex.: { "A": "Amarelo", "B": "Azul" } (vazio = "Time A")
  createdAt   DateTime      @default(now())
  players     MatchPlayer[] // escalação dos times
  goals       Goal[] // gols lançados na súmula
  events      MatchEvent[] // cartões e defesas difíceis
  attendances Attendance[] // lista de presença (confirmados + espera)
  guests      MatchGuest[] // convidados (gente de fora do grupo)
  mvpVotes    MvpVote[] // votação do craque depois da partida
  games       MatchGame[] // jogos da pelada (vazio no jogo único)
  ratings     Rating[] // LEGADO: avaliação pós-partida, fora de uso (a tabela fica até uma limpeza futura)
  group       Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId])
}

// Escalação: um jogador em um time de uma partida.
// A chave (matchId, playerId) impede o mesmo jogador duas vezes na partida,
// inclusive nos dois times ao mesmo tempo.
model MatchPlayer {
  matchId  Int
  playerId Int
  team     Team
  benched  Boolean @default(false) // saiu de campo numa substituição: continua contando como quem jogou
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict) // quem jogou não pode ser excluído

  @@id([matchId, playerId])
  @@index([playerId])
}

// Gol lançado na súmula. `team` é o time que GANHA o gol (o servidor calcula):
// no gol contra, é o adversário de quem chutou, e o gol não conta para o autor.
model Goal {
  id        Int        @id @default(autoincrement())
  matchId   Int
  scorerId  Int // quem fez o gol
  assistId  Int? // quem deu a assistência (opcional)
  team      Team
  ownGoal   Boolean    @default(false)
  minute    Int? // minuto do jogo (opcional)
  gameId    Int? // jogo da pelada em que saiu (vazio no jogo único)
  createdAt DateTime   @default(now())
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  game      MatchGame? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  scorer    Player     @relation("GoalScorer", fields: [scorerId], references: [id], onDelete: Restrict)
  assist    Player?    @relation("GoalAssist", fields: [assistId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([gameId])
  @@index([scorerId])
  @@index([assistId])
}

// Nota de um jogador para outro depois de uma partida (1 a 5). Edita, não duplica:
// a chave única (matchId, raterId, ratedId) permite uma nota por avaliador, avaliado e partida.
// O CHECK de 1 a 5 existe só no SQL da migração (o Prisma não expressa CHECK): última barreira.
model Rating {
  id        Int      @id @default(autoincrement())
  matchId   Int
  raterId   Int // quem avaliou (nunca é mostrado ao avaliado)
  ratedId   Int // quem foi avaliado
  score     Int
  comment   String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rater     Player   @relation("RatingGiven", fields: [raterId], references: [id], onDelete: Restrict)
  rated     Player   @relation("RatingReceived", fields: [ratedId], references: [id], onDelete: Restrict)

  @@unique([matchId, raterId, ratedId])
  @@index([ratedId])
  @@index([matchId])
}

// Lances da súmula que não são gol. Gol e assistência continuam no Goal (o placar sai dele).
enum EventType {
  YELLOW_CARD
  RED_CARD
  DIFFICULT_SAVE
}

// Cartão ou defesa difícil lançado durante a partida (só com ela em andamento).
model MatchEvent {
  id        Int        @id @default(autoincrement())
  matchId   Int
  playerId  Int
  type      EventType
  minute    Int? // minuto do jogo (opcional)
  gameId    Int? // jogo da pelada em que aconteceu (vazio no jogo único)
  createdAt DateTime   @default(now())
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  game      MatchGame? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([gameId])
  @@index([playerId])
}

// Presença confirmada numa partida agendada: substitui a "lista do fut" do WhatsApp.
// Confirmado ou espera NÃO é gravado: sai da ordem de chegada (createdAt) e das vagas da partida.
// Assim, quando alguém sai, o primeiro da espera sobe sozinho.
model Attendance {
  matchId   Int
  playerId  Int
  maybe     Boolean  @default(false) // "talvez": fica na espera por vontade própria, mesmo com vaga
  createdAt DateTime @default(now()) // ordem de chegada (muda quando a pessoa troca entre confirmado e talvez)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([matchId, playerId])
  @@index([playerId])
}

// Um jogo dentro da pelada: dois dos times da partida se enfrentam. O placar não é gravado
// (sai dos gols do jogo); o resultado é gravado ao encerrar o jogo. Só um jogo aberto por vez
// (índice único parcial na migração: finishedAt IS NULL).
model MatchGame {
  id         Int          @id @default(autoincrement())
  matchId    Int
  number     Int // 1, 2, 3... na ordem da noite
  homeTeam   Team
  awayTeam   Team
  result     GameResult? // vazio enquanto o jogo está rolando
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  match      Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  goals      Goal[]
  events     MatchEvent[]

  @@unique([matchId, number])
}

// Convidado de uma partida: alguém de fora do grupo, só com o nome (o amigo que vem uma vez).
// Ocupa vaga só depois dos jogadores do grupo; quem convidou aparece ao lado do nome.
model MatchGuest {
  id          Int      @id @default(autoincrement())
  matchId     Int
  name        String   @db.VarChar(40)
  invitedById Int? // jogador que levou (vazio = posto por um admin sem jogador)
  createdAt   DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  invitedBy   Player?  @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([matchId])
}

// Voto de craque: cada jogador que jogou dá um voto por partida (pode trocar até a votação fechar).
// O CHECK "não vota em si mesmo" existe só no SQL da migração.
model MvpVote {
  matchId   Int
  voterId   Int
  votedId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voter     Player   @relation("VoteGiven", fields: [voterId], references: [id], onDelete: Cascade)
  voted     Player   @relation("VoteReceived", fields: [votedId], references: [id], onDelete: Cascade)

  @@id([matchId, voterId])
  @@index([votedId])
}

// Foto do jogador: no máximo uma por jogador (a chave é o próprio playerId). Fica numa tabela
// separada para que nenhuma consulta de Player traga os bytes sem pedir. Ver ADR 0015.
model PlayerPhoto {
  playerId  Int      @id
  mimeType  String   @db.VarChar(20) // image/jpeg, image/png ou image/webp (conferido pelos bytes)
  data      Bytes // a imagem em si (até 200 KB; o front envia ~256 x 256)
  updatedAt DateTime @updatedAt // vira a "versão" da foto na URL (?v=...), para o cache
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
