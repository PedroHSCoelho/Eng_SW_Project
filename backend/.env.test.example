# Banco de TESTE (npm run test:db). Copie para ".env.test" (não vai para o Git).
# Mesmo projeto Supabase de DEV, mas num schema separado chamado "test": os testes apagam
# tudo antes de cada caso, então ele NUNCA pode ser o schema "public" nem o banco de produção.
# As duas URLs usam o Session pooler (porta 5432): os testes abrem poucas conexões.
BANCO=test
DATABASE_URL="postgresql://postgres.[ID-DO-PROJETO-DEV]:[SENHA-DEV]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?schema=test"
DIRECT_URL="postgresql://postgres.[ID-DO-PROJETO-DEV]:[SENHA-DEV]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?schema=test"
JWT_SECRET=segredo-so-dos-testes-com-mais-de-32-caracteres
