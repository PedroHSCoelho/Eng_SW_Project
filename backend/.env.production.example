# Banco de PRODUÇÃO (o mesmo que a Vercel usa). Copie para ".env.production" (não vai para o Git).
# Só é lido por "npm run db:deploy:prod" e "npm run db:status:prod" (aplicar/conferir migrações).
# O script de ambientes recusa qualquer outro comando aqui (reset, migrate dev, seed, testes).
BANCO=producao
DATABASE_URL="postgresql://postgres.[ID-DO-PROJETO-PROD]:[SENHA-PROD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ID-DO-PROJETO-PROD]:[SENHA-PROD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"
